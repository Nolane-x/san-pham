<Window
    x:Class="Magic.Capture.App.Views.DesignToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Magic Capture Desktop — Design Tools">
    <Grid x:Name="Root" Padding="14" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="10">
            <TextBlock Text="Live screen picker" FontSize="20" FontWeight="SemiBold"/>
            <Border BorderBrush="#555" BorderThickness="1" Width="220" Height="220">
                <Grid>
                    <Image x:Name="MagnifierImage" Stretch="Fill"/>
                    <Rectangle Width="16" Height="16" Stroke="Red" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                    <Rectangle Height="1" Fill="#AAFF0000" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Fill="#AAFF0000" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock x:Name="CoordinateText" FontFamily="Consolas"/>
            <Border x:Name="CurrentSwatch" Height="54" CornerRadius="6" BorderBrush="#555" BorderThickness="1"/>
            <TextBlock x:Name="CurrentColorText" FontFamily="Consolas" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Save swatch" Click="SaveSwatch_Click"/>
                <Button Content="Sample 64×64" Click="SampleRegion_Click"/>
            </StackPanel>
            <TextBlock x:Name="RegionStatsText" TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Formats" FontSize="20" FontWeight="SemiBold"/>
                <VariableSizedWrapGrid Orientation="Horizontal">
                    <Button Content="HEX" Tag="hex" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                    <Button Content="RGB" Tag="rgb" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                    <Button Content="HSL" Tag="hsl" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                    <Button Content="HSV" Tag="hsv" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                    <Button Content="CMYK" Tag="cmyk" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                    <Button Content="CSS" Tag="css" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                    <Button Content="C#" Tag="csharp" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                    <Button Content="C/C++" Tag="cpp" Click="CopyColorFormat_Click" Margin="0,0,6,6"/>
                </VariableSizedWrapGrid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ContrastColorBox" Header="Contrast against" Text="#FFFFFF" Width="160"/>
                    <Button Content="Check WCAG" Click="Contrast_Click" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="ContrastText" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </StackPanel>
                <TextBlock Text="Palette" FontSize="18" FontWeight="SemiBold"/>
                <TextBox x:Name="PaletteText" IsReadOnly="True" AcceptsReturn="True" Height="92" FontFamily="Consolas" TextWrapping="Wrap"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Color history" FontWeight="SemiBold"/>
                        <ListView x:Name="HistoryList" Height="190" SelectionChanged="ColorList_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="Saved swatches" FontWeight="SemiBold"/>
                        <ListView x:Name="SwatchList" Height="190" SelectionChanged="ColorList_SelectionChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Measurement &amp; desktop" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Name="DpiBox" Header="DPI" Minimum="10" Maximum="2000" Value="96" Width="120" SpinButtonPlacementMode="Compact"/>
                    <Button Content="Calibrate DPI…" Click="CalibrateDpi_Click" VerticalAlignment="Bottom"/>
                </StackPanel>
                <VariableSizedWrapGrid Orientation="Horizontal">
                    <Button Content="Pixel ruler / protractor" Click="Ruler_Click" Margin="0,0,6,6"/>
                    <Button Content="Screen Focus" Click="Focus_Click" Margin="0,0,6,6"/>
                    <Button Content="Whiteboard" Click="Whiteboard_Click" Margin="0,0,6,6"/>
                </VariableSizedWrapGrid>
                <TextBlock Text="Ruler shows X/Y, ΔX/ΔY, pixels, inches/cm and angle. All measurement tools are on-demand and close with Esc." TextWrapping="Wrap" Opacity="0.65"/>
                <TextBlock x:Name="DesignStatusText" TextWrapping="Wrap" Opacity="0.7"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
