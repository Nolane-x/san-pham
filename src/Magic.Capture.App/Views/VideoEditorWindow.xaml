<Window
    x:Class="Magic.Capture.App.Views.VideoEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Magic Capture Desktop — Clip Editor">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Label="Add clips" Icon="Add" Click="AddClips_Click"/>
            <AppBarButton Label="Open project" Click="OpenProject_Click"/>
            <AppBarButton Label="Save project" Icon="Save" Click="SaveProject_Click"/>
            <AppBarButton Label="Undo" Click="Undo_Click"/>
            <AppBarButton Label="Redo" Click="Redo_Click"/>
            <AppBarSeparator/>
            <AppBarButton Label="Refresh preview" Click="RefreshPreview_Click"/>
            <AppBarButton Label="Export MP4" Click="ExportMp4_Click"/>
            <AppBarButton Label="Capture frame" Click="CaptureFrame_Click"/>
            <AppBarButton Label="Contact sheet" Click="ContactSheet_Click"/>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Timeline" FontSize="18" FontWeight="SemiBold"/>
                <ListView x:Name="TimelineList" Grid.Row="1" SelectionChanged="TimelineList_SelectionChanged" MinHeight="260"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="↑" ToolTipService.ToolTip="Move earlier" Click="MoveUp_Click"/>
                    <Button Content="↓" ToolTipService.ToolTip="Move later" Click="MoveDown_Click"/>
                    <Button Content="Duplicate" Click="Duplicate_Click"/>
                    <Button Content="Remove" Click="Remove_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="3" x:Name="TimelineSummaryText" Text="No clips." TextWrapping="Wrap" Opacity="0.65"/>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border CornerRadius="10" BorderThickness="1" Padding="8">
                        <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="True" AutoPlay="False" MinHeight="300"/>
                    </Border>

                    <TextBlock Text="Selected segment" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedSourceText" Text="Select a timeline segment." TextWrapping="Wrap" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="TrimStartBox" Header="Keep from (s)" Width="140" Minimum="0" Maximum="86400" Value="0" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="TrimEndBox" Header="Keep to (s)" Width="140" Minimum="0" Maximum="86400" Value="0" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="VolumeBox" Header="Volume %" Width="120" Minimum="0" Maximum="200" Value="100" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="PlaybackRateBox" Header="Speed ×" Width="105" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.25" SpinButtonPlacementMode="Compact"/>
                        <CheckBox x:Name="MuteCheck" Content="Mute" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="CutStartBox" Header="Cut from (s)" Width="140" Minimum="0" Maximum="86400" Value="0" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="CutEndBox" Header="Cut to (s)" Width="140" Minimum="0" Maximum="86400" Value="0" SpinButtonPlacementMode="Compact"/>
                        <Button Content="Cut interval" Click="CutInterval_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <Button Content="Apply selected" Click="ApplySegment_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>

                    <TextBlock Text="Crop" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="CropEnabledCheck" Content="Enable crop" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        <NumberBox x:Name="CropXBox" Header="X %" Width="90" Minimum="0" Maximum="99" Value="0" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="CropYBox" Header="Y %" Width="90" Minimum="0" Maximum="99" Value="0" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="CropWidthBox" Header="Width %" Width="105" Minimum="1" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="CropHeightBox" Header="Height %" Width="105" Minimum="1" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>

                    <TextBlock Text="Audio envelope" FontWeight="SemiBold"/>
                    <ListView x:Name="AudioKeyframeList" MinHeight="58" MaxHeight="110" SelectionMode="Single"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="AudioKeyframeTimeBox" Header="At (s)" Width="95" Minimum="0" Maximum="14400" Value="0"/>
                        <NumberBox x:Name="AudioKeyframeGainBox" Header="Gain %" Width="95" Minimum="0" Maximum="200" Value="100"/>
                        <ComboBox x:Name="AudioKeyframeEasingCombo" Header="Easing" Width="120" SelectedIndex="0">
                            <ComboBoxItem Content="Linear" Tag="Linear"/><ComboBoxItem Content="Ease in" Tag="EaseIn"/><ComboBoxItem Content="Ease out" Tag="EaseOut"/><ComboBoxItem Content="Ease in/out" Tag="EaseInOut"/><ComboBoxItem Content="Hold" Tag="Hold"/>
                        </ComboBox>
                        <Button Content="Add / update" Click="AddAudioKeyframe_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <Button Content="Remove" Click="RemoveAudioKeyframe_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="AudioFadeInBox" Header="Fade in (s)" Width="105" Minimum="0" Maximum="60" Value="0.5"/>
                        <NumberBox x:Name="AudioFadeOutBox" Header="Fade out (s)" Width="105" Minimum="0" Maximum="60" Value="0.5"/>
                        <CheckBox x:Name="AudioDuckCheck" Content="Duck" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        <NumberBox x:Name="AudioDuckStartBox" Header="Duck from (s)" Width="115" Minimum="0" Maximum="14400" Value="1"/>
                        <NumberBox x:Name="AudioDuckEndBox" Header="Duck to (s)" Width="115" Minimum="0" Maximum="14400" Value="3"/>
                        <NumberBox x:Name="AudioDuckGainBox" Header="Duck gain %" Width="110" Minimum="0" Maximum="200" Value="35"/>
                        <Button Content="Apply fade / duck" Click="ApplyAudioEnvelopePreset_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <Button Content="Clear envelope" Click="ClearAudioEnvelope_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>

                    <TextBlock Text="Output" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="OutputWidthBox" Header="Width" Width="120" Minimum="2" Maximum="16384" Value="1920" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="OutputHeightBox" Header="Height" Width="120" Minimum="2" Maximum="16384" Value="1080" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="OutputFpsBox" Header="FPS" Width="90" Minimum="15" Maximum="60" Value="30" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="FrameTimeBox" Header="Frame at (s)" Width="130" Minimum="0" Maximum="86400" Value="0" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="ContactFramesBox" Header="Sheet frames" Width="125" Minimum="1" Maximum="64" Value="16" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>

                    <TextBlock Text="Advanced timeline" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <Border CornerRadius="8" BorderThickness="1" Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Title card" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="TitleCardTextBox" Header="Text" Width="360" MaxLength="512" Text="Title"/>
                                <NumberBox x:Name="TitleCardDurationBox" Header="Duration (s)" Width="120" Minimum="0.25" Maximum="60" Value="2" SpinButtonPlacementMode="Compact"/>
                                <Button Content="Add after selected" Click="AddTitleCard_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="TitleFontFamilyBox" Header="Font" Width="150" Text="Segoe UI" MaxLength="96"/>
                                <ComboBox x:Name="TitleFontWeightCombo" Header="Weight" Width="100" SelectedIndex="2">
                                    <ComboBoxItem Content="Regular" Tag="400"/>
                                    <ComboBoxItem Content="SemiBold" Tag="600"/>
                                    <ComboBoxItem Content="Bold" Tag="700"/>
                                    <ComboBoxItem Content="Black" Tag="900"/>
                                </ComboBox>
                                <CheckBox x:Name="TitleItalicCheck" Content="Italic" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                <CheckBox x:Name="TitleUnderlineCheck" Content="Underline" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                <ComboBox x:Name="TitleAlignCombo" Header="Align" Width="100" SelectedIndex="1">
                                    <ComboBoxItem Content="Left" Tag="Left"/>
                                    <ComboBoxItem Content="Center" Tag="Center"/>
                                    <ComboBoxItem Content="Right" Tag="Right"/>
                                </ComboBox>
                                <NumberBox x:Name="TitleShadowBox" Header="Shadow" Width="90" Minimum="0" Maximum="16" Value="0" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="TitleOutlineBox" Header="Outline" Width="90" Minimum="0" Maximum="12" Value="0" SpinButtonPlacementMode="Compact"/>
                                <Button Content="Apply selected title" Click="ApplyTitleStyle_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>

                            <TextBlock Text="Timed overlays" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <ListView x:Name="OverlayList" MinHeight="96" MaxHeight="150" SelectionMode="Single" SelectionChanged="OverlayList_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="OverlayKindCombo" Header="Kind" Width="140" SelectedIndex="0">
                                    <ComboBoxItem Content="Text"/>
                                    <ComboBoxItem Content="Rectangle"/>
                                    <ComboBoxItem Content="Ellipse"/>
                                    <ComboBoxItem Content="Arrow"/>
                                    <ComboBoxItem Content="Redaction"/>
                                </ComboBox>
                                <TextBox x:Name="OverlayTextBox" Header="Text" Width="260" MaxLength="1024" Text="Note"/>
                                <NumberBox x:Name="OverlayStartBox" Header="Start (s)" Width="110" Minimum="0" Maximum="86400" Value="0" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayDurationBox" Header="Duration (s)" Width="115" Minimum="0.05" Maximum="86400" Value="2" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="OverlayXBox" Header="X %" Width="85" Minimum="0" Maximum="99" Value="10" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayYBox" Header="Y %" Width="85" Minimum="0" Maximum="99" Value="10" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayWidthBox" Header="Width %" Width="95" Minimum="1" Maximum="100" Value="30" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayHeightBox" Header="Height %" Width="95" Minimum="1" Maximum="100" Value="15" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayOpacityBox" Header="Opacity %" Width="105" Minimum="0" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayStrokeBox" Header="Stroke" Width="90" Minimum="0" Maximum="32" Value="3" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="OverlayFontFamilyBox" Header="Text font" Width="145" Text="Segoe UI" MaxLength="96"/>
                                <ComboBox x:Name="OverlayFontWeightCombo" Header="Weight" Width="100" SelectedIndex="2">
                                    <ComboBoxItem Content="Regular" Tag="400"/>
                                    <ComboBoxItem Content="SemiBold" Tag="600"/>
                                    <ComboBoxItem Content="Bold" Tag="700"/>
                                    <ComboBoxItem Content="Black" Tag="900"/>
                                </ComboBox>
                                <CheckBox x:Name="OverlayItalicCheck" Content="Italic" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                <CheckBox x:Name="OverlayUnderlineCheck" Content="Underline" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                <ComboBox x:Name="OverlayAlignCombo" Header="Align" Width="100" SelectedIndex="1">
                                    <ComboBoxItem Content="Left" Tag="Left"/>
                                    <ComboBoxItem Content="Center" Tag="Center"/>
                                    <ComboBoxItem Content="Right" Tag="Right"/>
                                </ComboBox>
                                <NumberBox x:Name="OverlayShadowBox" Header="Shadow" Width="85" Minimum="0" Maximum="16" Value="0" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayOutlineBox" Header="Outline" Width="85" Minimum="0" Maximum="12" Value="0" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add overlay" Click="AddOverlay_Click"/>
                                <Button Content="Remove selected overlay" Click="RemoveOverlay_Click"/>
                                <Button Content="Auto-track selected redaction" Click="TrackRedaction_Click"/>
                            </StackPanel>
                            <TextBlock Text="Overlay keyframes · geometry + opacity + easing" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <ListView x:Name="OverlayKeyframeList" MinHeight="64" MaxHeight="120" SelectionMode="Single"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="OverlayKeyframeTimeBox" Header="At (s)" Width="95" Minimum="0" Maximum="14400" Value="0" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="OverlayKeyframeXBox" Header="X %" Width="80" Minimum="0" Maximum="99" Value="10"/>
                                <NumberBox x:Name="OverlayKeyframeYBox" Header="Y %" Width="80" Minimum="0" Maximum="99" Value="10"/>
                                <NumberBox x:Name="OverlayKeyframeWidthBox" Header="W %" Width="80" Minimum="1" Maximum="100" Value="30"/>
                                <NumberBox x:Name="OverlayKeyframeHeightBox" Header="H %" Width="80" Minimum="1" Maximum="100" Value="15"/>
                                <NumberBox x:Name="OverlayKeyframeOpacityBox" Header="Opacity %" Width="95" Minimum="0" Maximum="100" Value="100"/>
                                <ComboBox x:Name="OverlayKeyframeEasingCombo" Header="Easing" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="Linear" Tag="Linear"/><ComboBoxItem Content="Ease in" Tag="EaseIn"/><ComboBoxItem Content="Ease out" Tag="EaseOut"/><ComboBoxItem Content="Ease in/out" Tag="EaseInOut"/><ComboBoxItem Content="Hold" Tag="Hold"/>
                                </ComboBox>
                                <Button Content="Add / update" Click="AddOverlayKeyframe_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                <Button Content="Remove" Click="RemoveOverlayKeyframe_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>

                            <TextBlock Text="Rendered frame effects" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <ListView x:Name="FrameEffectList" MinHeight="76" MaxHeight="130" SelectionMode="Single" SelectionChanged="FrameEffectList_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="FrameEffectKindCombo" Header="Effect" Width="145" SelectedIndex="0">
                                    <ComboBoxItem Content="Zoom / pan" Tag="ZoomPan"/>
                                    <ComboBoxItem Content="Gaussian blur" Tag="GaussianBlur"/>
                                    <ComboBoxItem Content="Pixelate" Tag="Pixelate"/>
                                </ComboBox>
                                <NumberBox x:Name="FrameEffectStartBox" Header="Start (s)" Width="105" Minimum="0" Maximum="14400" Value="0" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="FrameEffectDurationBox" Header="Duration (s)" Width="110" Minimum="0.05" Maximum="14400" Value="2" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="FrameEffectPrimaryStartBox" Header="Start value" Width="110" Minimum="1" Maximum="64" Value="1" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="FrameEffectPrimaryEndBox" Header="End value" Width="110" Minimum="1" Maximum="64" Value="2" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="FrameEffectXStartBox" Header="Start X %" Width="100" Minimum="0" Maximum="100" Value="50" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="FrameEffectYStartBox" Header="Start Y %" Width="100" Minimum="0" Maximum="100" Value="50" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="FrameEffectXEndBox" Header="End X %" Width="100" Minimum="0" Maximum="100" Value="50" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="FrameEffectYEndBox" Header="End Y %" Width="100" Minimum="0" Maximum="100" Value="50" SpinButtonPlacementMode="Compact"/>
                                <Button Content="Add effect" Click="AddFrameEffect_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FrameEffectEasingCombo" Header="Easing" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="Linear" Tag="Linear"/><ComboBoxItem Content="Ease in" Tag="EaseIn"/><ComboBoxItem Content="Ease out" Tag="EaseOut"/><ComboBoxItem Content="Ease in/out" Tag="EaseInOut"/><ComboBoxItem Content="Hold" Tag="Hold"/>
                                </ComboBox>
                                <Button Content="Remove effect" Click="RemoveFrameEffect_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="Effect keyframes" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <ListView x:Name="FrameKeyframeList" MinHeight="64" MaxHeight="120" SelectionMode="Single"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="FrameKeyframeTimeBox" Header="At (s)" Width="90" Minimum="0" Maximum="14400" Value="0"/>
                                <NumberBox x:Name="FrameKeyframePrimaryBox" Header="Value" Width="90" Minimum="1" Maximum="64" Value="1"/>
                                <NumberBox x:Name="FrameKeyframeXBox" Header="X %" Width="80" Minimum="0" Maximum="100" Value="50"/>
                                <NumberBox x:Name="FrameKeyframeYBox" Header="Y %" Width="80" Minimum="0" Maximum="100" Value="50"/>
                                <ComboBox x:Name="FrameKeyframeEasingCombo" Header="Easing" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="Linear" Tag="Linear"/><ComboBoxItem Content="Ease in" Tag="EaseIn"/><ComboBoxItem Content="Ease out" Tag="EaseOut"/><ComboBoxItem Content="Ease in/out" Tag="EaseInOut"/><ComboBoxItem Content="Hold" Tag="Hold"/>
                                </ComboBox>
                                <Button Content="Add / update" Click="AddFrameKeyframe_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                <Button Content="Remove" Click="RemoveFrameKeyframe_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="Zoom uses value 1–4× and X/Y focus. Gaussian blur uses radius 1–32 px. Pixelate uses cell 2–64 px." TextWrapping="Wrap" Opacity="0.62"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Extract &amp; convert" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="AudioFormatCombo" Header="Audio" Width="140" SelectedIndex="2">
                            <ComboBoxItem Content="WAV"/>
                            <ComboBoxItem Content="MP3"/>
                            <ComboBoxItem Content="M4A / AAC"/>
                        </ComboBox>
                        <Button Content="Extract audio" Click="ExtractAudio_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <ComboBox x:Name="VideoFormatCombo" Header="Video" Width="170" SelectedIndex="0">
                            <ComboBoxItem Content="H.264 MP4"/>
                            <ComboBoxItem Content="HEVC MP4"/>
                            <ComboBoxItem Content="WMV"/>
                        </ComboBox>
                        <Button Content="Convert video" Click="ConvertVideo_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <ProgressBar x:Name="RenderProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            <TextBlock x:Name="EditorStatusText" Text="Non-destructive editor ready. Source files are never modified." TextWrapping="Wrap" Opacity="0.72"/>
        </StackPanel>
    </Grid>
</Window>
