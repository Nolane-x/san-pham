<Window
    x:Class="Magic.Capture.App.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="Black"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
            <KeyboardAccelerator Key="Enter" Invoked="ConfirmAccelerator_Invoked" />
            <KeyboardAccelerator Key="Back" Invoked="UndoShapeAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Invoked="CopyAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Invoked="SaveAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Invoked="PinAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Invoked="TextAccelerator_Invoked" />
            <KeyboardAccelerator Key="E" Invoked="EditAccelerator_Invoked" />
            <KeyboardAccelerator Key="M" Invoked="MagicAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Invoked="NudgeAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="NudgeAccelerator_Invoked" />
            <KeyboardAccelerator Key="Up" Invoked="NudgeAccelerator_Invoked" />
            <KeyboardAccelerator Key="Down" Invoked="NudgeAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Shift" Invoked="NudgeAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Shift" Invoked="NudgeAccelerator_Invoked" />
            <KeyboardAccelerator Key="Up" Modifiers="Shift" Invoked="NudgeAccelerator_Invoked" />
            <KeyboardAccelerator Key="Down" Modifiers="Shift" Invoked="NudgeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Image x:Name="FrozenImage" Stretch="Fill" Opacity="0.72" />
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="SnapRectangle" Visibility="Collapsed" Stroke="#FF38BDF8" StrokeThickness="2" StrokeDashArray="5,3" Fill="#1838BDF8" IsHitTestVisible="False" />
            <Border x:Name="SnapLabelBadge" Visibility="Collapsed" IsHitTestVisible="False" Background="#F2181F2B" BorderBrush="#FF38BDF8" BorderThickness="1" CornerRadius="4" Padding="7,3">
                <TextBlock x:Name="SnapLabelText" Foreground="White" FontSize="11" MaxWidth="300" TextTrimming="CharacterEllipsis" />
            </Border>
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Stroke="White"
                       StrokeThickness="2"
                       Fill="#12000000" />
            <Ellipse x:Name="SelectionEllipse" Visibility="Collapsed" Stroke="White" StrokeThickness="2" Fill="#12000000" IsHitTestVisible="False" />
            <Polygon x:Name="SelectionPath" Visibility="Collapsed" Stroke="White" StrokeThickness="2" Fill="#18000000" IsHitTestVisible="False" />
            <Polyline x:Name="SelectionPathPreview" Visibility="Collapsed" Stroke="White" StrokeThickness="2" IsHitTestVisible="False" />

            <Border x:Name="HandleNorthWest" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>
            <Border x:Name="HandleNorth" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>
            <Border x:Name="HandleNorthEast" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>
            <Border x:Name="HandleEast" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>
            <Border x:Name="HandleSouthEast" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>
            <Border x:Name="HandleSouth" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>
            <Border x:Name="HandleSouthWest" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>
            <Border x:Name="HandleWest" Width="10" Height="10" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" PointerPressed="ResizeHandle_PointerPressed"/>

            <Border x:Name="SizeBadge" Visibility="Collapsed"
                    Background="#E61A1A1A" CornerRadius="4" Padding="8,4">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>

            <Border x:Name="ActionBar" Visibility="Collapsed" PointerPressed="ActionBar_PointerPressed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="6">
                <CommandBar x:Name="SelectionActionCommandBar" DefaultLabelPosition="Right" IsOpen="True" IsDynamicOverflowEnabled="True">
                    <AppBarButton x:Name="OverlayCopyAction" Label="Copy" Click="CopyButton_Click" />
                    <AppBarButton x:Name="OverlaySaveAction" Label="Save" Click="SaveButton_Click" />
                    <AppBarButton x:Name="OverlayPinAction" Label="Pin" Click="PinButton_Click" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="OverlayTextAction" Label="Text" Click="TextButton_Click" />
                    <AppBarButton x:Name="TableAction" Label="Table · PLUS" Click="TableButton_Click" />
                    <AppBarButton x:Name="BarcodeAction" Label="QR · PLUS" Click="BarcodeButton_Click" />
                    <AppBarButton x:Name="OverlayEditAction" Label="Edit" Click="EditButton_Click" />
                    <AppBarButton x:Name="OverlayColorAction" Label="Color" Click="ColorButton_Click" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="MagicAction" Label="Magic · PRO" Click="MagicButton_Click" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Label="Workflow: Quick Copy" Click="QuickCopyWorkflow_Click" />
                        <AppBarButton Label="Workflow: OCR → Copy" Click="OcrWorkflow_Click" />
                        <AppBarButton Label="Workflow: Documentation · PLUS" Click="DocumentationWorkflow_Click" />
                        <AppBarButton Label="Workflow: Data Capture · PLUS" Click="DataWorkflow_Click" />
                        <AppBarButton Label="Workflow: Bug Report · PRO" Click="BugReportWorkflow_Click" />
                        <AppBarSeparator />
                        <AppBarButton Label="Open result" Click="OpenButton_Click" />
                        <AppBarButton Label="Cancel" Click="CancelButton_Click" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Border>

            <Border x:Name="LoupeViewport" Width="132" Height="156" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#F21A1A1A" BorderBrush="White" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Image x:Name="LoupeImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Stroke="#99FFFFFF" StrokeThickness="1" Margin="65,0,65,0"/>
                        <Rectangle Stroke="#99FFFFFF" StrokeThickness="1" Margin="0,65,0,65"/>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="5" Height="5" BorderBrush="#FFFF5252" BorderThickness="1"/>
                    </Grid>
                    <TextBlock x:Name="LoupeCoordinateText" Grid.Row="1" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                Background="#E61A1A1A" CornerRadius="6" Padding="8,6">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Button x:Name="RectangleShapeButton" Content="Rectangle" Click="RectangleShape_Click" />
                    <Button x:Name="EllipseShapeButton" Content="Ellipse" Click="EllipseShape_Click" />
                    <Button x:Name="PolygonShapeButton" Content="Polygon" Click="PolygonShape_Click" />
                    <Button x:Name="FreehandShapeButton" Content="Freehand" Click="FreehandShape_Click" />
                    <Button x:Name="MultiRegionShapeButton" Content="Multi-region" Click="MultiRegionShape_Click" />
                    <Button x:Name="FinishShapeButton" Content="Finish shape" Click="FinishShape_Click" Visibility="Collapsed" />
                    <Button x:Name="UndoShapeButton" Content="Undo point/region" Click="UndoShape_Click" Visibility="Collapsed" />
                    <Button x:Name="MultiRegionOutputButton" Content="Output: Canvas" Click="MultiRegionOutput_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="ShapeStatusText" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Button x:Name="FreeformRatioButton" Content="Freeform" Click="FreeformRatio_Click" />
                    <Button x:Name="SquareRatioButton" Content="1:1 · PRO" Click="SquareRatio_Click" />
                    <Button x:Name="WideRatioButton" Content="16:9 · PRO" Click="WideRatio_Click" />
                    <Button x:Name="ClassicRatioButton" Content="4:3 · PRO" Click="ClassicRatio_Click" />
                    <Button Content="Reselect" Click="Reselect_Click" />
                    <Button x:Name="SnapModeButton" Content="Window snap on" Click="SnapMode_Click" />
                    <Button x:Name="OverlayModeButton" Content="Light overlay" Click="OverlayMode_Click" />
                </StackPanel>
                <TextBlock x:Name="OverlayHelpText" Foreground="White" FontSize="12" HorizontalAlignment="Center"
                           Text="Drag to select · resize handles · arrows nudge · Shift+arrows 10 px · C copy · S save · T text · M Magic · Esc cancel" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
