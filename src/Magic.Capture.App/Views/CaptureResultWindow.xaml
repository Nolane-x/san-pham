<Window
    x:Class="Magic.Capture.App.Views.CaptureResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Magic Capture Desktop — Result">

    <Grid Padding="18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copy image" Click="CopyImage_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Save" Click="SaveImage_Click" />
                <ComboBox x:Name="ImageFormatCombo" SelectedIndex="0" Width="100">
                    <ComboBoxItem Content="PNG" Tag="png" />
                    <ComboBoxItem Content="JPEG" Tag="jpg" />
                    <ComboBoxItem x:Name="BmpFormatItem" Content="BMP · PLUS" Tag="bmp" />
                    <ComboBoxItem x:Name="TiffFormatItem" Content="TIFF · PLUS" Tag="tiff" />
                </ComboBox>
                <Button Content="Pin" Click="Pin_Click" />
                <Button Content="Edit" Click="Edit_Click" />
                <Button Content="Magic · PRO" Click="Magic_Click" />
                <Button Content="Add to AI context · PRO" Click="AddToContext_Click" />
            </StackPanel>
            <TextBlock x:Name="AnalysisStatusText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" Text="Analyzing locally…" />
        </Grid>

        <TabView x:Name="ResultTabs" Grid.Row="1">
            <TabViewItem Header="Preview">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Click" VerticalAlignment="Center" Opacity="0.65" />
                        <ComboBox x:Name="OcrHitModeCombo" Width="110" SelectedIndex="0">
                            <ComboBoxItem Content="Word" Tag="word" />
                            <ComboBoxItem Content="Line" Tag="line" />
                            <ComboBoxItem Content="Block" Tag="block" />
                        </ComboBox>
                        <TextBox x:Name="OcrSearchBox" Width="260" MaxLength="256" PlaceholderText="Search OCR on screenshot" TextChanged="OcrSearchBox_TextChanged" />
                        <TextBlock x:Name="OcrSearchCountText" VerticalAlignment="Center" Opacity="0.65" />
                        <TextBlock x:Name="PreviewOcrHintText" Text="Click OCR evidence to copy." VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="PreviewSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" PointerPressed="PreviewSurface_PointerPressed">
                            <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Canvas x:Name="OcrOverlayCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="OcrSelectionRectangle" Visibility="Collapsed" StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Text">
                <Grid Padding="8" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy text" Click="CopyText_Click" />
                        <Button Content="Save TXT" Click="SaveText_Click" />
                        <TextBlock Text="View" VerticalAlignment="Center" Opacity="0.65" />
                        <ComboBox x:Name="OcrTextModeCombo" Width="120" SelectedIndex="0" SelectionChanged="OcrTextMode_SelectionChanged">
                            <ComboBoxItem Content="Plain" Tag="plain" />
                            <ComboBoxItem Content="Layout" Tag="layout" />
                            <ComboBoxItem Content="Code" Tag="code" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="OCR language" VerticalAlignment="Center" Opacity="0.65" />
                        <ComboBox x:Name="OcrResultLanguageCombo" Width="220" />
                        <Button x:Name="RerunOcrButton" Content="Re-run OCR" Click="RerunOcr_Click" />
                        <Button Content="Windows language packs…" Click="OpenLanguageSettings_Click" />
                        <ProgressRing x:Name="OcrRerunProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBox x:Name="OcrTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" FontFamily="Consolas" />
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="TableTab" Header="Table · PLUS">
                <Grid Padding="8" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="TableFormatCombo" Width="150" SelectionChanged="TableFormat_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Content="CSV (comma)" Tag="csv" />
                            <ComboBoxItem Content="CSV (semicolon)" Tag="csv-semicolon" />
                            <ComboBoxItem Content="TSV" Tag="tsv" />
                            <ComboBoxItem Content="Excel-safe TSV" Tag="excel-tsv" />
                            <ComboBoxItem Content="Markdown" Tag="md" />
                            <ComboBoxItem Content="HTML" Tag="html" />
                            <ComboBoxItem Content="JSON" Tag="json" />
                        </ComboBox>
                        <ComboBox x:Name="TableLocaleCombo" Width="150" SelectionChanged="TableFormat_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Content="Preserve numbers" Tag="preserve" />
                            <ComboBoxItem Content="Invariant decimal" Tag="invariant" />
                            <ComboBoxItem Content="Current locale" Tag="current" />
                        </ComboBox>
                        <Button x:Name="CopyTableButton" Content="Copy" Click="CopyTable_Click" />
                        <Button x:Name="SaveTableButton" Content="Save" Click="SaveTable_Click" />
                        <Button x:Name="EditTableButton" Content="Edit table…" Click="OpenTableWorkspace_Click" />
                        <TextBlock x:Name="TableConfidenceText" VerticalAlignment="Center" Opacity="0.65" />
                    </StackPanel>
                    <TextBlock x:Name="TableDiagnosticsText" Grid.Row="1" Opacity="0.65" TextWrapping="Wrap" />
                    <TextBox x:Name="TableOutputTextBox" Grid.Row="2" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" />
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="BarcodeTab" Header="QR / Barcode · PLUS">
                <Grid Padding="8" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy selected" Click="CopyBarcode_Click" />
                        <Button Content="Open link" Click="OpenBarcode_Click" />
                    </StackPanel>
                    <ListView x:Name="BarcodeList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8">
                                    <TextBlock Text="{Binding Format}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Signals">
                <Grid Padding="8" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy selected" Click="CopySignal_Click"/>
                        <TextBlock Text="Deterministic — URLs, email, paths, errors, stack frames and numeric signals. No AI." VerticalAlignment="Center" Opacity="0.65"/>
                    </StackPanel>
                    <ListView x:Name="SignalsList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Confidence}" Opacity="0.6"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Metadata">
                <TextBox x:Name="MetadataTextBox" Margin="8" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" />
            </TabViewItem>
        </TabView>

        <TextBlock x:Name="FooterText" Grid.Row="2" Opacity="0.6" TextWrapping="Wrap" />
    </Grid>
</Window>
