<Window
    x:Class="Magic.Capture.App.Views.PinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Magic Capture Desktop — Pin">
    <Grid x:Name="Root" Background="#111111" PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited">
        <ScrollViewer x:Name="PinScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
            <Grid x:Name="ImageHost" MinWidth="1" MinHeight="1" PointerPressed="ImageHost_PointerPressed">
                <Image x:Name="PinnedImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Canvas x:Name="PinAnnotationCanvas" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>
        <Border x:Name="PinControls" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#E61A1A1A" CornerRadius="7" Padding="5" Opacity="0" IsHitTestVisible="False">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="−" ToolTipService.ToolTip="Zoom out" Click="ZoomOut_Click" />
                    <Button Content="+" ToolTipService.ToolTip="Zoom in" Click="ZoomIn_Click" />
                    <Button Content="Fit" Click="Fit_Click" />
                    <Button Content="1:1" ToolTipService.ToolTip="Actual pixels" Click="ActualSize_Click" />
                    <Button Content="Reset" Click="Reset_Click" />
                    <Button Content="Copy" Click="Copy_Click" />
                    <Button Content="Save" Click="Save_Click" />
                    <Button Content="Edit" Click="Edit_Click" />
                    <Button x:Name="ClickThroughButton" Content="Click-through · PRO" Click="ClickThrough_Click" />
                    <Button Content="×" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Step" ToolTipService.ToolTip="Place numbered markers directly on the pin" Click="Step_Click" />
                    <Button Content="Note" ToolTipService.ToolTip="Place a text note directly on the pin" Click="Note_Click" />
                    <Button Content="Clear marks" Click="ClearMarks_Click" />
                    <Button Content="Min" Click="Minimize_Click" />
                    <Button x:Name="EdgeButton" Content="Edge" Click="HideEdge_Click" />
                    <Button x:Name="LockButton" Content="Lock" Click="LockPosition_Click" />
                    <Button Content="Grid pins" Click="ArrangePins_Click" />
                    <Button Content="Snap pins" Click="SnapPins_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="100%" Click="Opacity100_Click" />
                    <Button Content="90%" Click="Opacity90_Click" />
                    <Button Content="75%" Click="Opacity75_Click" />
                    <Button Content="50%" Click="Opacity50_Click" />
                    <TextBlock x:Name="PinStatusText" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
