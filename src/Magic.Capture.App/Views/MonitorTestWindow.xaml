<Window
    x:Class="Magic.Capture.App.Views.MonitorTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Black">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Close_Invoked"/>
            <KeyboardAccelerator Key="Space" Invoked="ToggleControls_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid x:Name="TestSurface" Background="Black"/>
        <Border x:Name="ControlsPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16"
                Padding="10" CornerRadius="8" Background="#DD202020">
            <StackPanel Spacing="7">
                <TextBlock x:Name="MonitorLabel" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Button Content="Black" Click="Black_Click"/>
                    <Button Content="White" Click="White_Click"/>
                    <Button Content="Red" Click="Red_Click"/>
                    <Button Content="Green" Click="Green_Click"/>
                    <Button Content="Blue" Click="Blue_Click"/>
                    <Button Content="Gradient" Click="Gradient_Click"/>
                    <Button Content="Color bars" Click="ColorBars_Click"/>
                    <Button Content="Grid" Click="Grid_Click"/>
                    <Button Content="Close" Click="Close_Click"/>
                </StackPanel>
                <TextBlock Text="Solid colors: dead-pixel test · Gradient: banding test · Color bars: calibration · Space: hide/show controls · Esc: close"
                           Foreground="#CCFFFFFF" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
