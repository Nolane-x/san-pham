<Window
    x:Class="Magic.Capture.App.Views.AnnotationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Magic Capture Desktop — Editor">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
            <StackPanel x:Name="EditorToolbar" Orientation="Horizontal" Spacing="8" Padding="12,10">
                <ComboBox x:Name="ToolCombo" Width="138" SelectionChanged="ToolCombo_SelectionChanged">
                    <ComboBoxItem Content="Rectangle" Tag="Rectangle" IsSelected="True"/>
                    <ComboBoxItem Content="Ellipse" Tag="Ellipse"/>
                    <ComboBoxItem Content="Line" Tag="Line"/>
                    <ComboBoxItem Content="Arrow" Tag="Arrow"/>
                    <ComboBoxItem Content="Pen" Tag="Freehand"/>
                    <ComboBoxItem x:Name="HighlightTool" Content="Highlight · PLUS" Tag="Highlight"/>
                    <ComboBoxItem Content="Text" Tag="Text"/>
                    <ComboBoxItem Content="Speech balloon" Tag="SpeechBalloon"/>
                    <ComboBoxItem Content="Callout" Tag="Callout"/>
                    <ComboBoxItem Content="Step 1/2/3" Tag="StepNumber"/>
                    <ComboBoxItem Content="Step A/B/C" Tag="StepAlpha"/>
                    <ComboBoxItem Content="Step I/II/III" Tag="StepRoman"/>
                    <ComboBoxItem Content="Cursor stamp" Tag="CursorStamp"/>
                    <ComboBoxItem Content="Click stamp" Tag="ClickStamp"/>
                    <ComboBoxItem Content="Emoji" Tag="Emoji"/>
                    <ComboBoxItem Content="Magnify" Tag="Magnify"/>
                    <ComboBoxItem Content="Spotlight" Tag="Spotlight"/>
                    <ComboBoxItem Content="Curved line" Tag="CurvedLine"/>
                    <ComboBoxItem Content="Curved arrow" Tag="CurvedArrow"/>
                    <ComboBoxItem Content="Bracket" Tag="Bracket"/>
                    <ComboBoxItem x:Name="BlurTool" Content="Blur · PLUS" Tag="Blur"/>
                    <ComboBoxItem x:Name="PixelateTool" Content="Pixelate · PLUS" Tag="Pixelate"/>
                    <ComboBoxItem Content="Crop" Tag="Crop"/>
                    <ComboBoxItem Content="Color picker" Tag="Color"/>
                </ComboBox>
                <TextBox x:Name="TextInput" Width="180" PlaceholderText="Text annotation" Visibility="Collapsed"/>
                <TextBlock Text="Width" VerticalAlignment="Center"/>
                <Slider x:Name="StrokeSlider" Width="110" Minimum="1" Maximum="16" Value="3" StepFrequency="1"/>
                <ComboBox x:Name="StylePresetCombo" Width="150" DisplayMemberPath="Name" PlaceholderText="Style preset"/>
                <TextBox x:Name="StylePresetName" Width="120" PlaceholderText="Style name"/>
                <Button Content="Apply style" Click="ApplyStylePreset_Click"/>
                <Button Content="Save style" Click="SaveStylePreset_Click"/>
                <Button Content="Delete style" Click="DeleteStylePreset_Click"/>
                <Button x:Name="ToolbarUndoButton" Content="Undo" Click="Undo_Click"/>
                <Button x:Name="ToolbarRedoButton" Content="Redo" Click="Redo_Click"/>
                <Button x:Name="ToolbarRotateButton" Content="Rotate 90°" Click="Rotate_Click"/>
                <Button Content="Flip H" Click="FlipH_Click"/>
                <Button Content="Flip V" Click="FlipV_Click"/>
                <Button x:Name="ToolbarResizeButton" Content="Resize…" Click="Resize_Click"/>
                <Button Content="Smart Redact" Click="SmartRedact_Click" ToolTipService.ToolTip="Find common sensitive data locally and add editable pixelation layers"/>
                <Button x:Name="ToolbarCopyButton" Content="Copy" Click="Copy_Click"/>
                <Button x:Name="ToolbarSaveButton" Content="Save PNG" Click="Save_Click"/>
                <Button Content="Save Project…" Click="SaveProject_Click"/>
                <Button Content="Open Project…" Click="OpenProject_Click"/>
                <Button x:Name="ToolbarPinButton" Content="Pin" Click="Pin_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <ScrollViewer ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Border Margin="16" Background="#FF202020" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid x:Name="ImageSurface" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="InteractionCanvas" Background="Transparent"
                                PointerPressed="InteractionCanvas_PointerPressed"
                                PointerMoved="InteractionCanvas_PointerMoved"
                                PointerReleased="InteractionCanvas_PointerReleased">
                            <Rectangle x:Name="GestureRect" Stroke="#FFFFC107" StrokeThickness="2"
                                       Fill="#20FFC107" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </Border>
            </ScrollViewer>
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Layers" FontSize="18" FontWeight="SemiBold"/>
                    <ListView x:Name="LayerList" Grid.Row="1" SelectionMode="Multiple" DisplayMemberPath="Kind" SelectionChanged="LayerList_SelectionChanged"/>
                    <ScrollViewer Grid.Row="2" MaxHeight="330" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Copy" Click="LayerCopy_Click"/><Button Content="Paste" Click="LayerPaste_Click"/>
                                <Button Content="Duplicate" Click="LayerDuplicate_Click"/><Button Content="Delete" Click="LayerDelete_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Group" Click="LayerGroup_Click"/><Button Content="Ungroup" Click="LayerUngroup_Click"/>
                                <Button Content="Show/Hide" Click="LayerVisibility_Click"/><Button Content="Lock/Unlock" Click="LayerLock_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Back" Click="LayerBack_Click"/><Button Content="↓" Click="LayerBackward_Click"/><Button Content="↑" Click="LayerForward_Click"/><Button Content="Front" Click="LayerFront_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="←" Click="LayerLeft_Click"/><Button Content="↑" Click="LayerUp_Click"/><Button Content="↓" Click="LayerDown_Click"/><Button Content="→" Click="LayerRight_Click"/><Button Content="Rotate 15°" Click="LayerRotate_Click"/>
                            </StackPanel>
                            <TextBlock Text="Layout" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="L" ToolTipService.ToolTip="Align left" Click="AlignLeft_Click"/><Button Content="R" ToolTipService.ToolTip="Align right" Click="AlignRight_Click"/>
                                <Button Content="T" ToolTipService.ToolTip="Align top" Click="AlignTop_Click"/><Button Content="B" ToolTipService.ToolTip="Align bottom" Click="AlignBottom_Click"/>
                                <Button Content="↔" ToolTipService.ToolTip="Distribute horizontally" Click="DistributeHorizontal_Click"/><Button Content="↕" ToolTipService.ToolTip="Distribute vertically" Click="DistributeVertical_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Same W" Click="MatchWidth_Click"/><Button Content="Same H" Click="MatchHeight_Click"/><Button Content="Same size" Click="MatchBoth_Click"/>
                            </StackPanel>
                            <TextBlock Text="Bounds" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Grid ColumnSpacing="4" RowSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <NumberBox x:Name="LayerXBox" Header="X" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="LayerYBox" Grid.Column="1" Header="Y" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="LayerWBox" Grid.Column="2" Header="W" Minimum="1" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="LayerHBox" Grid.Column="3" Header="H" Minimum="1" SpinButtonPlacementMode="Compact"/>
                            </Grid>
                            <Button Content="Apply bounds" Click="ApplyLayerBounds_Click" HorizontalAlignment="Left"/>
                            <TextBlock Text="Style" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox x:Name="StrokeColorBox" Width="92" Header="Stroke" PlaceholderText="#RRGGBB"/>
                                <NumberBox x:Name="LayerOpacityBox" Width="78" Header="Opacity %" Minimum="0" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ComboBox x:Name="LineStyleCombo" Width="104" Header="Line" SelectedIndex="0">
                                    <ComboBoxItem Content="Solid" Tag="Solid"/><ComboBoxItem Content="Dash" Tag="Dash"/><ComboBoxItem Content="Dot" Tag="Dot"/>
                                </ComboBox>
                                <TextBox x:Name="FillColorBox" Width="92" Header="Fill" PlaceholderText="empty / #RGB"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox x:Name="FontFamilyBox" Width="120" Header="Font" Text="Segoe UI"/>
                                <NumberBox x:Name="LayerFontSizeBox" Width="82" Header="Size" Minimum="8" Maximum="256" Value="18" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="LayerBoldCheck" Content="Bold"/><CheckBox x:Name="LayerItalicCheck" Content="Italic"/>
                                <ComboBox x:Name="TextAlignmentCombo" Width="92" SelectedIndex="0">
                                    <ComboBoxItem Content="Left" Tag="Left"/><ComboBoxItem Content="Center" Tag="Center"/><ComboBoxItem Content="Right" Tag="Right"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Content="Apply style" Click="ApplyLayerStyle_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Draw on the capture. Everything stays local." VerticalAlignment="Center"/>
            <TextBlock x:Name="ColorText" Grid.Column="1" Margin="12,0,0,0" FontFamily="Consolas" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
