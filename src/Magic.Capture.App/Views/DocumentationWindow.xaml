<Window
    x:Class="Magic.Capture.App.Views.DocumentationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Magic Capture · Documentation Builder">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Step Recorder &amp; Documentation Builder" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Record an explicit local session, then edit each step and export a shareable guide. Printable keystrokes and password values are never stored." TextWrapping="Wrap" Opacity="0.68"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="StartStopButton" Content="Start recording" Click="StartStopRecording_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Add image…" Click="AddImage_Click"/>
                <Button Content="Open…" Click="OpenProject_Click"/>
                <Button Content="Save…" Click="SaveProject_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectTitleBox" Header="Guide title" Text="Magic Capture guide"/>
                <TextBox x:Name="ProjectSubtitleBox" Grid.Column="1" Header="Subtitle"/>
                <ComboBox x:Name="TemplateComboBox" Grid.Column="2" Header="Page template" MinWidth="190"/>

                <TextBox x:Name="ProjectHeaderBox" Grid.Row="1" Header="Header" PlaceholderText="Optional document header"/>
                <TextBox x:Name="ProjectFooterBox" Grid.Row="1" Grid.Column="1" Header="Footer" PlaceholderText="Optional document footer"/>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                    <TextBlock Text="Logo (optional)" Opacity="0.72"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Choose logo…" Click="ChooseLogo_Click"/>
                        <Button Content="Clear" Click="ClearLogo_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LogoStatusText" Text="No logo" Opacity="0.62" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="StepCountText" Text="0 steps" FontWeight="SemiBold"/>
                <ListView x:Name="StepList" Grid.Row="1" SelectionMode="Single" SelectionChanged="StepList_SelectionChanged"
                          CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                          DragItemsCompleted="StepList_DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4" Spacing="2">
                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplayDescription}" Opacity="0.62" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="↑" ToolTipService.ToolTip="Move up" Click="MoveStepUp_Click"/>
                        <Button Content="↓" ToolTipService.ToolTip="Move down" Click="MoveStepDown_Click"/>
                        <Button Content="Duplicate" Click="DuplicateStep_Click"/>
                        <Button Content="Merge next" Click="MergeNext_Click"/>
                        <Button Content="Remove" Click="RemoveStep_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="10" Padding="0,0,8,8">
                    <Image x:Name="StepPreviewImage" Height="340" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="StepTitleBox" Header="Step title"/>
                        <TextBox x:Name="StepSectionBox" Grid.Column="1" Header="Section (optional)"/>
                    </Grid>
                    <TextBox x:Name="StepDescriptionBox" Header="Instruction" AcceptsReturn="True" TextWrapping="Wrap" Height="100"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply selected step" Click="ApplyStep_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <TextBlock x:Name="StepEvidenceText" VerticalAlignment="Center" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border BorderBrush="#33808080" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Export" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="All exports stay local. HTML/Markdown folder exports create a dedicated subfolder inside the folder you choose." TextWrapping="Wrap" Opacity="0.62"/>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" HorizontalChildrenAlignment="Left" VerticalChildrenAlignment="Top">
                                <Button Margin="0,0,8,8" Content="Long PNG…" Click="ExportLongPng_Click"/>
                                <Button Margin="0,0,8,8" Content="PDF…" Click="ExportPdf_Click"/>
                                <Button Margin="0,0,8,8" Content="DOCX…" Click="ExportDocx_Click"/>
                                <Button Margin="0,0,8,8" Content="HTML folder…" Click="ExportHtml_Click"/>
                                <Button Margin="0,0,8,8" Content="Markdown folder…" Click="ExportMarkdown_Click"/>
                                <Button Margin="0,0,8,8" Content="Offline HTML…" Click="ExportOfflineHtml_Click"/>
                            </WrapGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="True" Severity="Informational" IsClosable="False" Message="Ready. Recording starts only when you press Start recording."/>
    </Grid>
</Window>
