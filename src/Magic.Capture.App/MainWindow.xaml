                                <TextBlock Text="Routing never sends a request to a disabled profile. Local-only privacy overrides routing and blocks cloud providers." TextWrapping="Wrap" Opacity="0.6"/>
                                <Button Content="Save AI privacy settings" Click="AiSavePrivacy_Click" HorizontalAlignment="Left"/>

                                <TextBlock Text="Magic Actions" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="Built-in actions are optimized for errors, code, tables, UI, documents and semantic comparison. Custom actions are stored locally and contain instructions only — no executable scripts." TextWrapping="Wrap" Opacity="0.7"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                    <ListView x:Name="CustomActionList" DisplayMemberPath="Name" Height="200"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBox x:Name="CustomActionNameBox" Header="Custom action name"/>
                                        <TextBox x:Name="CustomActionCategoryBox" Header="Category" Text="Custom"/>
                                        <TextBox x:Name="CustomActionPromptBox" Header="Instruction" AcceptsReturn="True" TextWrapping="Wrap" Height="90"/>
                                        <CheckBox x:Name="CustomActionVisionCheck" Content="Vision is useful"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Save custom action" Click="SaveCustomAction_Click"/>
                                            <Button Content="Delete selected" Click="DeleteCustomAction_Click"/>
                                            <Button Content="Import .magicaction" Click="ImportCustomAction_Click"/>
                                            <Button Content="Export selected" Click="ExportCustomAction_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Magic Recipes" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="PRO — hybrid pipelines that mix deterministic workflow steps with Magic Actions. Recipe files are declarative and contain no executable scripts." TextWrapping="Wrap" Opacity="0.7"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                                    <ListView x:Name="MagicRecipeList" DisplayMemberPath="Name" Height="220" SelectionChanged="MagicRecipeList_SelectionChanged"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBox x:Name="MagicRecipeNameBox" Header="Recipe name"/>
                                        <TextBox x:Name="MagicRecipeStepsBox" Header="Steps — AI:action-id or STEP:WorkflowStepKind[:argument]" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Height="120" PlaceholderText="STEP:RunOcr&#x0a;STEP:ExtractSignals&#x0a;AI:developer.bug-report&#x0a;STEP:CopyText:markdown"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="New" Click="MagicRecipeNew_Click"/>
                                            <Button Content="Save recipe" Click="MagicRecipeSave_Click"/>
                                            <Button Content="Delete" Click="MagicRecipeDelete_Click"/>
                                            <Button Content="Import .magicrecipe" Click="MagicRecipeImport_Click"/>
                                            <Button Content="Export" Click="MagicRecipeExport_Click"/>
                                        </StackPanel>
                                        <Button Content="Run on selected History capture" Click="MagicRecipeRun_Click" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"/>
                                        <TextBlock x:Name="MagicRecipeStatusText" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Context Stack" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AiContextStatusText" VerticalAlignment="Center" Text="0 / 8 captures"/>
                                    <Button Content="Clear context" Click="ClearAiContext_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Resident behavior" FontWeight="SemiBold"/>
                            <ToggleSwitch x:Name="StartWithWindowsToggle" Header="Start Magic Capture Desktop with Windows" Toggled="StartWithWindows_Toggled"/>
                            <TextBlock x:Name="StartupStatusText" Opacity="0.65" TextWrapping="Wrap"/>
                            <TextBlock Text="Closing this window always hides it to the tray. Use Exit Magic Capture Desktop in the tray to stop the resident process." Opacity="0.65" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Theme" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Width="150" SelectedIndex="0"><ComboBoxItem Content="System" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox></StackPanel>

                            <TextBlock Text="Capture hotkey" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Selection overlay" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CaptureOverlayThemeCombo" Width="170" SelectedIndex="0">
                                    <ComboBoxItem Content="Dark overlay" Tag="Dark"/>
                                    <ComboBoxItem Content="Light overlay" Tag="Light"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"><CheckBox x:Name="HotkeyWin" Content="Win" IsChecked="True"/><CheckBox x:Name="HotkeyCtrl" Content="Ctrl"/><CheckBox x:Name="HotkeyAlt" Content="Alt"/><CheckBox x:Name="HotkeyShift" Content="Shift" IsChecked="True"/><TextBox x:Name="HotkeyKey" Width="56" MaxLength="1" Text="X"/></StackPanel>
                            <CheckBox x:Name="CaptureCursorCheck" Content="Include mouse cursor in captures"/>
                            <Button Content="Reset capture section" Click="ResetCaptureSection_Click" HorizontalAlignment="Left"/>

                            <TextBlock Text="Personal hotkeys" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="Add global shortcuts for capture modes, workflows, Magic Actions, or opening the last History capture in the editor." Opacity="0.65" TextWrapping="Wrap"/>
                            <ListView x:Name="PersonalHotkeyList" Height="110" DisplayMemberPath="Name" SelectionChanged="PersonalHotkeyList_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="PersonalHotkeyNameBox" Width="150" PlaceholderText="Name"/>
                                <ComboBox x:Name="PersonalHotkeyKindCombo" Width="130" SelectedIndex="0">
                                    <ComboBoxItem Content="Capture" Tag="Capture"/><ComboBoxItem Content="Workflow" Tag="Workflow"/><ComboBoxItem Content="Magic Action" Tag="MagicAction"/><ComboBoxItem Content="Editor" Tag="Editor"/>
                                </ComboBox>
                                <TextBox x:Name="PersonalHotkeyTargetBox" Width="190" PlaceholderText="Target ID / capture mode"/>
                                <CheckBox x:Name="PersonalHotkeyEnabledCheck" Content="Enabled" IsChecked="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="PersonalHotkeyWinCheck" Content="Win"/><CheckBox x:Name="PersonalHotkeyCtrlCheck" Content="Ctrl" IsChecked="True"/><CheckBox x:Name="PersonalHotkeyAltCheck" Content="Alt"/><CheckBox x:Name="PersonalHotkeyShiftCheck" Content="Shift" IsChecked="True"/>
                                <TextBox x:Name="PersonalHotkeyKeyBox" Width="70" PlaceholderText="M / F8"/>
                                <Button Content="Save hotkey" Click="SavePersonalHotkey_Click"/><Button Content="Delete" Click="DeletePersonalHotkey_Click"/>
                            </StackPanel>
                            <Button Content="Reset hotkeys section" Click="ResetHotkeysSection_Click" HorizontalAlignment="Left"/>

                            <TextBlock Text="Toolbar &amp; overlay personalization" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Editor toolbar"/>
                                    <ListView x:Name="ToolbarActionList" Height="120" DisplayMemberPath="Display"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Button Content="Up" Click="MoveToolbarActionUp_Click"/><Button Content="Down" Click="MoveToolbarActionDown_Click"/><Button Content="Show / hide" Click="ToggleToolbarAction_Click"/></StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Capture overlay action bar"/>
                                    <ListView x:Name="OverlayActionList" Height="120" DisplayMemberPath="Display"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Button Content="Up" Click="MoveOverlayActionUp_Click"/><Button Content="Down" Click="MoveOverlayActionDown_Click"/><Button Content="Show / hide" Click="ToggleOverlayAction_Click"/></StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Default editor tool" VerticalAlignment="Center"/><ComboBox x:Name="DefaultAnnotationToolCombo" Width="170"/>
                                <CheckBox x:Name="RememberLastAnnotationToolCheck" Content="Remember last-used tool" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Saved annotation styles"/>
                            <ListView x:Name="AnnotationStylePresetList" Height="90" DisplayMemberPath="Name"/>
                            <Button Content="Delete selected saved style" Click="DeleteAnnotationStylePreset_Click" HorizontalAlignment="Left"/>
                            <Button Content="Reset personalization section" Click="ResetPersonalizationSection_Click" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="AutoCopyCheck" Content="Automatically copy image after capture"/>
                            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Default post-capture action" VerticalAlignment="Center"/><ComboBox x:Name="PostCaptureActionCombo" Width="180" SelectedIndex="0"><ComboBoxItem Content="Open result" Tag="ResultWindow"/><ComboBoxItem Content="Copy image" Tag="CopyImage"/><ComboBoxItem Content="Pin image" Tag="PinImage"/><ComboBoxItem Content="Save" Tag="Save"/></ComboBox></StackPanel>

                            <TextBlock Text="OCR and output" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="OCR language" VerticalAlignment="Center"/><ComboBox x:Name="OcrLanguageCombo" Width="220"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="JPEG quality" VerticalAlignment="Center"/><NumberBox x:Name="JpegQualityBox" Width="110" Minimum="1" Maximum="100" Value="92"/></StackPanel>
                            <TextBox x:Name="FilenameTemplateBox" Header="Filename template"/>
                            <Button Content="Reset output section" Click="ResetOutputSection_Click" HorizontalAlignment="Left"/>

                            <TextBlock Text="Privacy · local redaction" FontWeight="SemiBold"/>
                            <TextBlock Text="Sensitive-data detection stays on this device. Enable only the outbound paths you want Magic Capture Desktop to sanitize." Opacity="0.65" TextWrapping="Wrap"/>
                            <VariableSizedWrapGrid Orientation="Horizontal">
                                <CheckBox x:Name="RedactBeforeCopyCheck" Content="Before Copy" Margin="0,0,16,0"/>
                                <CheckBox x:Name="RedactBeforeSaveCheck" Content="Before Save" Margin="0,0,16,0"/>
                                <CheckBox x:Name="RedactBeforePinCheck" Content="Before Pin" Margin="0,0,16,0"/>
                                <CheckBox x:Name="RedactBeforeWorkflowCheck" Content="Before Workflow"/>
                            </VariableSizedWrapGrid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Redaction style" VerticalAlignment="Center"/>
                                <ComboBox x:Name="RedactionStyleCombo" Width="150" SelectedIndex="0">
                                    <ComboBoxItem Content="Pixelate" Tag="Pixelate"/>
                                    <ComboBoxItem Content="Blur" Tag="Blur"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBox x:Name="SensitiveWordsBox" Header="Sensitive words · one per line" AcceptsReturn="True" TextWrapping="Wrap" Height="84" PlaceholderText="internal-project-name&#x0a;customer-secret"/>
                            <TextBox x:Name="SensitivePatternsBox" Header="Custom patterns · Label=regular expression, one per line" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Height="96" PlaceholderText="Employee ID=EMP-\d{6}"/>
                            <Button Content="Reset privacy section" Click="ResetPrivacySection_Click" HorizontalAlignment="Left"/>

                            <TextBlock Text="History" FontWeight="SemiBold"/>
                            <CheckBox x:Name="HistoryEnabledCheck" Content="Keep local capture history" IsChecked="True"/>
                            <StackPanel Orientation="Horizontal" Spacing="10"><NumberBox x:Name="HistoryDaysBox" Header="Maximum days (0 = unlimited with Pro)" Width="210" Minimum="0" Maximum="3650" Value="30"/><NumberBox x:Name="HistoryCountBox" Header="Maximum items (0 = unlimited with Pro)" Width="210" Minimum="0" Maximum="100000" Value="500"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Default pin opacity" VerticalAlignment="Center"/><NumberBox x:Name="PinOpacityBox" Width="110" Minimum="50" Maximum="100" Value="100"/></StackPanel>
                            <Button Content="Reset history section" Click="ResetHistorySection_Click" HorizontalAlignment="Left"/>

                            <TextBlock Text="Context preferences" FontWeight="SemiBold"/>
                            <TextBlock Text="Override capture behavior for a monitor or choose a capture profile when a specific foreground app is active. Rules store executable file names only." Opacity="0.65" TextWrapping="Wrap"/>
                            <TextBlock Text="Per-monitor"/>
                            <ListView x:Name="MonitorPreferenceList" Height="90" DisplayMemberPath="DeviceName" SelectionChanged="MonitorPreferenceList_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="MonitorDeviceNameBox" Width="200" PlaceholderText="\\.\DISPLAY1"/>
                                <ComboBox x:Name="MonitorCursorOverrideCombo" Width="120" SelectedIndex="0"><ComboBoxItem Content="Cursor: inherit" Tag="Inherit"/><ComboBoxItem Content="Cursor: on" Tag="On"/><ComboBoxItem Content="Cursor: off" Tag="Off"/></ComboBox>
                                <ComboBox x:Name="MonitorActionOverrideCombo" Width="155"/>
                                <Button Content="Save" Click="SaveMonitorPreference_Click"/><Button Content="Delete" Click="DeleteMonitorPreference_Click"/>
                            </StackPanel>
                            <TextBlock Text="Per-app capture rules"/>
                            <ListView x:Name="AppCaptureRuleList" Height="100" DisplayMemberPath="ExecutableName" SelectionChanged="AppCaptureRuleList_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="AppRuleExecutableBox" Width="150" PlaceholderText="app.exe"/>
                                <ComboBox x:Name="AppRuleProfileCombo" Width="190" DisplayMemberPath="Name"/>
                                <ComboBox x:Name="AppRuleCursorOverrideCombo" Width="120" SelectedIndex="0"><ComboBoxItem Content="Cursor: inherit" Tag="Inherit"/><ComboBoxItem Content="Cursor: on" Tag="On"/><ComboBoxItem Content="Cursor: off" Tag="Off"/></ComboBox>
                                <ComboBox x:Name="AppRuleActionOverrideCombo" Width="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"><CheckBox x:Name="AppRuleEnabledCheck" Content="Enabled" IsChecked="True"/><Button Content="Save app rule" Click="SaveAppCaptureRule_Click"/><Button Content="Delete" Click="DeleteAppCaptureRule_Click"/><Button Content="Reset context preferences" Click="ResetContextPreferencesSection_Click"/></StackPanel>

                            <TextBlock Text="Resilience &amp; portability" FontWeight="SemiBold"/>
                            <TextBlock Text="Export/import local configuration without credentials or trust approvals. Repair disposable AI cache independently from History." Opacity="0.65" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Export configuration" Click="ConfigurationArchiveExport_Click"/>
                                <Button Content="Import configuration" Click="ConfigurationArchiveImport_Click"/>
                                <Button Content="Repair AI result cache" Click="RepairAiCache_Click"/>
                            </StackPanel>

                            <Button Content="Save settings" Click="SaveSettings_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="SettingsStatusText" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PlanPage" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock Text="Plan" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PlanPageTierText" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PlanPageDetailText" TextWrapping="Wrap" Opacity="0.7"/>
                            <InfoBar x:Name="PlanFeatureInfo" IsOpen="False" IsClosable="False" Severity="Informational"/>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="8"><TextBlock Text="Free" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Free forever"/><TextBlock Text="• Freeze region capture&#x0a;• Window/monitor/desktop&#x0a;• Copy/save&#x0a;• Basic OCR&#x0a;• Basic editor&#x0a;• Basic pins/history" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Plus" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="7-day trial only"/><TextBlock Text="• Everything in Free&#x0a;• Table extraction&#x0a;• QR/barcodes&#x0a;• Stitch&#x0a;• Advanced editor&#x0a;• Unlimited pins during trial" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="Pro" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Lifetime purchase"/><TextBlock Text="• Everything in Plus&#x0a;• Repeat/fixed capture&#x0a;• Compare workspace&#x0a;• Click-through pins&#x0a;• Unlimited history&#x0a;• AI providers / local AI&#x0a;• Magic Actions&#x0a;• Context Stack&#x0a;• Evidence anchoring&#x0a;• Semantic Compare" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="UpgradeButton" Content="Upgrade to Pro" Click="UpgradeToPro_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="ProPriceText" VerticalAlignment="Center" Opacity="0.75" Text="Price shown by Microsoft Store"/>
                            </StackPanel>
                            <TextBlock x:Name="PurchaseStatusText" TextWrapping="Wrap"/>
                            <TextBlock Text="Plus is never sold. The Plus trial requires no payment method and never auto-renews. Pro is a one-time Microsoft Store purchase. The displayed price comes directly from Microsoft Store for your market." Opacity="0.65" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AboutPage" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="10" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="About Magic Capture Desktop" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="A local-first Windows capture utility."/>
                        <TextBlock Text="Core capture and recognition are deterministic and local. Pro AI is optional BYOK/BYOM: connect your own cloud API or local endpoint. Magic Capture Desktop does not sell tokens or require a Magic Capture account." TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="Win + Shift + X — freeze and capture"/>
                        <TextBlock Text="The resident process exits only from the tray menu."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
