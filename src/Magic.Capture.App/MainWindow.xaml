<Window
    x:Class="Magic.Capture.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Magic Capture Desktop">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" SelectionChanged="Nav_SelectionChanged" IsBackButtonVisible="Collapsed" Header="Magic Capture Desktop">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" />
                <NavigationViewItem Content="History" Tag="history" />
                <NavigationViewItem Content="Workflows" Tag="workflows" />
                <NavigationViewItem Content="Utilities" Tag="utilities" />
                <NavigationViewItem Content="Destinations · PRO" Tag="destinations" />
                <NavigationViewItem Content="Stitch · PLUS" Tag="stitch" />
                <NavigationViewItem Content="Compare · PRO" Tag="compare" />
                <NavigationViewItem Content="AI &amp; Magic · PRO" Tag="ai" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" />
                <NavigationViewItem Content="Upgrade / Plan" Tag="plan" />
                <NavigationViewItem Content="About" Tag="about" />
            </NavigationView.FooterMenuItems>

            <Grid Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <InfoBar x:Name="GlobalInfoBar" Grid.Row="0" IsOpen="False" Margin="0,0,0,12" IsClosable="True" />

                <Grid x:Name="HomePage" Grid.Row="1">
                    <ScrollViewer>
                        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Magic Capture Desktop" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="Runs in the tray. Press Win + Shift + X anywhere to freeze the screen and capture." Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="PlanStatusText" Text="Plan: loading…" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TrialStatusText" Text="" Opacity="0.7" />
                                    </StackPanel>
                                    <Button x:Name="HomeUpgradeButton" Grid.Column="1" Content="Upgrade to Pro" Click="UpgradeToPro_Click" />
                                </Grid>
                            </Border>

                            <Border x:Name="EditableProjectRecoveryCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Unsaved editor work found" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EditableProjectRecoveryText" Text="A local autosave is available." TextWrapping="Wrap" Opacity="0.75"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Recover" Click="RecoverEditableProject_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="Discard" Click="DiscardEditableProjectRecovery_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="DocumentationRecoveryCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Unsaved documentation work found" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DocumentationRecoveryText" Text="A local documentation autosave is available." TextWrapping="Wrap" Opacity="0.75"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Recover" Click="RecoverDocumentationProject_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="Discard" Click="DiscardDocumentationRecovery_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="VideoEditRecoveryCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Unsaved video-edit work found" FontWeight="SemiBold" />
                                        <TextBlock x:Name="VideoEditRecoveryText" Text="A local video-edit autosave is available." TextWrapping="Wrap" Opacity="0.75"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Recover" Click="RecoverVideoEditProject_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="Discard" Click="DiscardVideoEditRecovery_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Capture" FontSize="20" FontWeight="SemiBold" />
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Capture region" Click="CaptureRegion_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Repeat last · PRO" Click="RepeatRegion_Click" />
                                    <Button Content="Auto scroll · PLUS" Click="CaptureAutoScroll_Click" />
                                    <Button Content="Virtual desktop" Click="CaptureVirtual_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Active monitor" Click="CaptureMonitor_Click" />
                                    <Button Content="Choose monitor…" Click="CaptureMonitorMenu_Click" />
                                    <Button Content="Foreground window" Click="CaptureWindow_Click" />
                                    <Button Content="Choose window…" Click="CaptureWindowMenu_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Default hotkey" VerticalAlignment="Center" />
                                <TextBlock x:Name="HotkeyStatusText" Text="Win + Shift + X" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="CaptureDelayCombo" Width="130" SelectedIndex="0">
                                    <ComboBoxItem Content="No delay" Tag="0" />
                                    <ComboBoxItem Content="3 seconds" Tag="3" />
                                    <ComboBoxItem Content="5 seconds" Tag="5" />
                                    <ComboBoxItem Content="10 seconds" Tag="10" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="HotkeyErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Capture profiles &amp; exact regions" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="CaptureProfileCombo" Width="250" DisplayMemberPath="Name" PlaceholderText="Saved profile"/>
                                        <Button Content="Run profile" Click="RunCaptureProfile_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="New profile…" Click="NewCaptureProfile_Click"/>
                                        <Button Content="Delete" Click="DeleteCaptureProfile_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="RecentRegionCombo" Width="250" DisplayMemberPath="Label" PlaceholderText="Recently used region"/>
                                        <Button Content="Capture recent region" Click="CaptureRecentRegion_Click"/>
                                        <Button Content="Exact region…" Click="CaptureExactRegion_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Screen recording" FontWeight="SemiBold" FontSize="18"/>
                                        <TextBlock x:Name="RecordingElapsedText" Text="00:00:00" Opacity="0.7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Local MP4/H.264, GIF and APNG recording. Capture frames use the same WGC → Desktop Duplication → GDI router as screenshots; effects are composited locally and recording controls are excluded from capture on supported Windows builds." TextWrapping="Wrap" Opacity="0.68"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="RecordingTargetCombo" Header="Target" Width="180" SelectedIndex="0">
                                            <ComboBoxItem Content="Region" Tag="Region"/>
                                            <ComboBoxItem Content="Window" Tag="Window"/>
                                            <ComboBoxItem Content="Monitor" Tag="Monitor"/>
                                            <ComboBoxItem Content="Virtual desktop" Tag="VirtualDesktop"/>
                                        </ComboBox>
                                        <NumberBox x:Name="RecordingFpsBox" Header="FPS" Width="90" Minimum="5" Maximum="60" Value="30" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="RecordingBitrateBox" Header="Mbps" Width="100" Minimum="1" Maximum="50" Value="8" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="RecordingScaleBox" Header="Scale %" Width="110" Minimum="25" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="RecordingCountdownBox" Header="Countdown" Width="115" Minimum="0" Maximum="10" Value="3" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="RecordingStopAfterBox" Header="Stop min (0=manual)" Width="155" Minimum="0" Maximum="240" Value="0" SpinButtonPlacementMode="Compact"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox x:Name="RecordingCursorCheck" Content="Include mouse cursor" IsChecked="True" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="RecordingOutputFormatCombo" Header="Output" Width="190" SelectedIndex="0" SelectionChanged="RecordingOutputFormat_SelectionChanged">
                                            <ComboBoxItem Content="MP4 / H.264" Tag="Mp4"/>
                                            <ComboBoxItem Content="Animated GIF" Tag="Gif"/>
                                            <ComboBoxItem Content="Animated PNG (APNG)" Tag="Apng"/>
                                            <ComboBoxItem Content="M4A / AAC audio only" Tag="M4a"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <CheckBox x:Name="RecordingCursorHighlightCheck" Content="Cursor highlight"/>
                                            <CheckBox x:Name="RecordingClickVisualizationCheck" Content="Left/right click ripple"/>
                                            <CheckBox x:Name="RecordingSafeKeyOverlayCheck" Content="Safe shortcut keys"/>
                                            <CheckBox x:Name="RecordingDrawCheck" Content="Draw: Ctrl+Alt+drag"/>
                                            <CheckBox x:Name="RecordingLiveZoomCheck" Content="Live zoom: Ctrl+Alt+Z"/>
                                            <NumberBox x:Name="RecordingZoomBox" Header="Zoom %" Width="105" Minimum="150" Maximum="300" Value="200" SpinButtonPlacementMode="Compact"/>
                                        </StackPanel>
                                        <TextBlock x:Name="RecordingEffectsStatusText" Text="Effects are local-only. Safe keys never retain plain typed characters; only shortcuts/function/navigation keys are rendered." TextWrapping="Wrap" Opacity="0.62"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox x:Name="RecordingSystemAudioCheck" Content="System audio" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="RecordingSystemAudioDeviceCombo" Header="Output device" Width="300" DisplayMemberPath="Name" PlaceholderText="Windows default output"/>
                                            <NumberBox x:Name="RecordingSystemAudioGainBox" Header="System gain %" Width="120" Minimum="0" Maximum="200" Value="100" SpinButtonPlacementMode="Compact"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox x:Name="RecordingMicrophoneCheck" Content="Microphone" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="RecordingMicrophoneDeviceCombo" Header="Input device" Width="300" DisplayMemberPath="Name" PlaceholderText="Windows default microphone"/>
                                            <NumberBox x:Name="RecordingMicrophoneGainBox" Header="Mic gain %" Width="120" Minimum="0" Maximum="200" Value="100" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox x:Name="RecordingAudioBitrateBox" Header="AAC kbps" Width="110" Minimum="96" Maximum="320" Value="192" SpinButtonPlacementMode="Compact"/>
                                            <Button Content="Refresh audio devices" Click="RecordingRefreshAudioDevices_Click" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock x:Name="RecordingAudioStatusText" Text="Audio off." TextWrapping="Wrap" Opacity="0.62"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox x:Name="RecordingWebcamCheck" Content="Webcam / Picture-in-Picture" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="RecordingWebcamDeviceCombo" Header="Camera" Width="310" DisplayMemberPath="Name" PlaceholderText="Windows default camera"/>
                                            <Button Content="Refresh cameras" Click="RecordingRefreshCameras_Click" VerticalAlignment="Bottom"/>
                                            <CheckBox x:Name="RecordingWebcamMirrorCheck" Content="Mirror" IsChecked="True" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox x:Name="RecordingWebcamPositionCombo" Header="Position" Width="150" SelectedIndex="3">
                                                <ComboBoxItem Content="Top left" Tag="TopLeft"/>
                                                <ComboBoxItem Content="Top right" Tag="TopRight"/>
                                                <ComboBoxItem Content="Bottom left" Tag="BottomLeft"/>
                                                <ComboBoxItem Content="Bottom right" Tag="BottomRight"/>
                                                <ComboBoxItem Content="Custom X/Y" Tag="Custom"/>
                                            </ComboBox>
                                            <NumberBox x:Name="RecordingWebcamXBox" Header="X %" Width="90" Minimum="0" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox x:Name="RecordingWebcamYBox" Header="Y %" Width="90" Minimum="0" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox x:Name="RecordingWebcamWidthBox" Header="Width %" Width="105" Minimum="10" Maximum="50" Value="25" SpinButtonPlacementMode="Compact"/>
                                            <ComboBox x:Name="RecordingWebcamShapeCombo" Header="Shape" Width="130" SelectedIndex="1">
                                                <ComboBoxItem Content="Rectangle" Tag="Rectangle"/>
                                                <ComboBoxItem Content="Rounded" Tag="Rounded"/>
                                                <ComboBoxItem Content="Circle" Tag="Circle"/>
                                            </ComboBox>
                                            <NumberBox x:Name="RecordingWebcamOpacityBox" Header="Opacity %" Width="110" Minimum="20" Maximum="100" Value="100" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox x:Name="RecordingWebcamBorderBox" Header="Border px" Width="105" Minimum="0" Maximum="12" Value="2" SpinButtonPlacementMode="Compact"/>
                                        </StackPanel>
                                        <TextBlock x:Name="RecordingWebcamStatusText" Text="Webcam off." TextWrapping="Wrap" Opacity="0.62"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="StartRecordingButton" Content="Start recording…" Click="RecordingStart_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button x:Name="RepeatRecordingRegionButton" Content="Repeat last region…" Click="RecordingRepeatRegion_Click"/>
                                        <Button x:Name="PauseRecordingButton" Content="Pause" Click="RecordingPause_Click" IsEnabled="False"/>
                                        <Button x:Name="ResumeRecordingButton" Content="Resume" Click="RecordingResume_Click" IsEnabled="False"/>
                                        <Button x:Name="StopRecordingButton" Content="Stop &amp; finalize" Click="RecordingStop_Click" IsEnabled="False"/>
                                        <Button x:Name="RecordingDiscardRecoveryButton" Content="Discard recovery marker" Click="RecordingDiscardRecovery_Click" Visibility="Collapsed"/>
                                        <Button Content="Open Clip Editor…" Click="OpenVideoEditor_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RecordingStatusText" Text="Ready." TextWrapping="Wrap" Opacity="0.72"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Recent captures" FontSize="20" FontWeight="SemiBold" />
                            <ListView x:Name="RecentHistoryList" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick" MaxHeight="340">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="64" Height="44" Background="#FF202020" CornerRadius="4"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding SourceKind}" FontWeight="SemiBold"/><TextBlock Text="{Binding Dimensions}" Opacity="0.65" FontSize="12"/></StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CreatedUtc}" VerticalAlignment="Center" Opacity="0.65"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed" AllowDrop="True" DragOver="History_DragOver" Drop="History_Drop">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                        <AppBarButton Label="Refresh" Click="RefreshHistory_Click"/>
                        <AppBarButton Label="Filters" Click="HistoryFilters_Click"/>
                        <AppBarButton Label="Library" Click="HistoryLibraryManager_Click"/>
                        <AppBarButton Label="Sessions" Click="HistorySessions_Click"/>
                        <AppBarButton Label="Duplicates" Click="HistoryDuplicates_Click"/>
                        <AppBarButton Label="History Doctor" Click="HistoryDoctor_Click"/>
                        <AppBarButton Label="Export archive" Click="HistoryArchiveExport_Click"/>
                        <AppBarButton Label="Import archive" Click="HistoryArchiveImport_Click"/>
                        <AppBarButton Label="Tag selected" Click="HistoryBatchTag_Click"/>
                        <AppBarButton Label="Export selected" Click="HistoryBatchExport_Click"/>
                        <AppBarButton Label="Import images" Click="HistoryImport_Click"/>
                        <AppBarButton Label="Delete selected" Click="HistoryBatchDelete_Click"/>
                        <AppBarButton Label="Add selected to AI context · PRO" Click="AddSelectedHistoryToAiContext_Click"/>
                        <AppBarButton Label="Clear history" Click="ClearHistory_Click"/>
                        <CommandBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="History" FontSize="26" FontWeight="SemiBold" Margin="4,0,6,0"/>
                                <TextBox x:Name="HistorySearchBox" Width="300" PlaceholderText="Search captures" TextChanged="HistorySearchBox_TextChanged"/>
                                <TextBlock x:Name="HistorySearchCountText" VerticalAlignment="Center" Opacity="0.6"/>
                                <TextBlock x:Name="HistoryFilterStatusText" VerticalAlignment="Center" Opacity="0.55"/>
                            </StackPanel>
                        </CommandBar.Content>
                    </CommandBar>
                    <Border Grid.Row="1" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="HistoryWorkspaceCombo" Width="180" Header="Workspace" SelectionChanged="HistoryOrganizationFilter_SelectionChanged"/>
                            <ComboBox x:Name="HistoryFolderCombo" Width="190" Header="Folder" SelectionChanged="HistoryOrganizationFilter_SelectionChanged"/>
                            <ComboBox x:Name="HistoryCollectionCombo" Width="180" Header="Collection" SelectionChanged="HistoryOrganizationFilter_SelectionChanged"/>
                            <ComboBox x:Name="HistoryViewCombo" Width="120" Header="View" SelectionChanged="HistoryOrganizationFilter_SelectionChanged">
                                <ComboBoxItem Content="List" Tag="list" IsSelected="True"/>
                                <ComboBoxItem Content="Timeline" Tag="timeline"/>
                            </ComboBox>
                            <TextBlock Text="Drop images or a folder here to import" VerticalAlignment="Bottom" Margin="10,0,0,7" Opacity="0.55"/>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="HistoryList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick" SelectionMode="Multiple">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="120" Height="76" Background="#FF202020" CornerRadius="4"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Image Source="{Binding ProcessIcon}" Width="18" Height="18" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding FavoriteGlyph}" Foreground="#FFFFC107"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Dimensions}" Opacity="0.65"/><TextBlock Text="{Binding FileSizeText}" Opacity="0.55"/><TextBlock Text="{Binding SessionText}" Opacity="0.55"/></StackPanel>
                                        <TextBlock Text="{Binding SourceMetadataText}" TextTrimming="CharacterEllipsis" Opacity="0.58"/>
                                        <TextBlock Text="{Binding TagsText}" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                                        <TextBlock Text="{Binding OcrPreview}" TextTrimming="CharacterEllipsis" MaxLines="2" Opacity="0.6"/>
                                        <TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.45"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CreatedUtc}" HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Button Content="Open" Click="HistoryOpen_Click"/><Button Content="Details…" Click="HistoryDetails_Click"/><Button Content="Reveal" Click="HistoryReveal_Click"/><Button Content="Delete" Click="HistoryDelete_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="HistoryTimelineList" Grid.Row="2" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="HistoryTimelineList_ItemClick" SelectionMode="Multiple">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8,4" Spacing="5">
                                    <TextBlock Text="{Binding DayLabel}" FontSize="18" FontWeight="SemiBold" Opacity="0.8"/>
                                    <Grid Padding="8" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="104" Height="66" Background="#FF202020" CornerRadius="4"><Image Source="{Binding Display.Thumbnail}" Stretch="Uniform"/></Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><Image Source="{Binding Display.ProcessIcon}" Width="18" Height="18"/><TextBlock Text="{Binding Display.DisplayTitle}" FontWeight="SemiBold"/></StackPanel>
                                            <TextBlock Text="{Binding Display.SourceMetadataText}" TextTrimming="CharacterEllipsis" Opacity="0.6"/>
                                            <TextBlock Text="{Binding Display.TagsText}" TextTrimming="CharacterEllipsis" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Display.CreatedUtc}"/><TextBlock Text="{Binding Display.Dimensions}" Opacity="0.55"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ScrollViewer x:Name="WorkflowsPage" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="18" MaxWidth="980" HorizontalAlignment="Left" Padding="0,0,12,24">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Capture Workflows" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Declarative after-capture pipelines. Run them from the Win + Shift + X overlay, Capture Profiles, CLI, or replay them on History items." TextWrapping="Wrap" Opacity="0.7"/>
                        </StackPanel>
                        <Grid ColumnSpacing="16" Height="330">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ListView x:Name="WorkflowList" SelectionChanged="WorkflowList_SelectionChanged" DisplayMemberPath="Name"/>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="WorkflowNameText" FontSize="20" FontWeight="SemiBold" Text="Select a workflow"/>
                                <TextBlock x:Name="WorkflowDescriptionText" TextWrapping="Wrap" Opacity="0.7"/>
                                <TextBlock x:Name="WorkflowTierText"/>
                                <ListView x:Name="WorkflowStepList" MaxHeight="190"/>
                                <TextBlock Text="Select one or more captures in History, then run this workflow here — or choose it from Capture Profiles/CLI." TextWrapping="Wrap" Opacity="0.6"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Click="RefreshWorkflows_Click"/>
                            <Button Content="Run on selected History capture(s)" Click="RunWorkflowOnHistory_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Run once with selected History as image loop" Click="RunWorkflowLoopOnHistory_Click"/>
                            <Button Content="Dry-run on one History capture" Click="WorkflowDryRun_Click"/>
                            <Button Content="Edit selected in Studio" Click="WorkflowBuilderEditSelected_Click"/>
                            <Button Content="Automation triggers…" Click="WorkflowTriggerManager_Click"/>
                            <TextBlock x:Name="WorkflowStatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border BorderThickness="0,1,0,0" BorderBrush="#33808080" Padding="0,16,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Workflow Studio · PLUS / PRO" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Build local after-capture pipelines visually. Steps can be dragged, reordered, disabled, retried, timed out, conditioned, imported/exported, and parameterized with bounded variables." TextWrapping="Wrap" Opacity="0.68"/>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="7">
                                        <TextBox x:Name="WorkflowBuilderNameBox" Header="Workflow name"/>
                                        <TextBox x:Name="WorkflowBuilderDescriptionBox" Header="Description" AcceptsReturn="True" TextWrapping="Wrap" Height="78"/>
